{
  "name": "dsh-session-graph",
  "version": "0.5.1",
  "description": "DSH Web plugin: a project session map with mainline dimensions, tags and PR links, plus /summarize-* commands that write DSH_SESSION_GRAPH.md.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlwu92/dsh-session-graph.git"
  },
  "homepage": "https://github.com/wlwu92/dsh-session-graph#readme",
  "bugs": {
    "url": "https://github.com/wlwu92/dsh-session-graph/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "preview.png",
    "test",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-graph",
    "session-map",
    "sessions",
    "summarize"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/load.mjs && node test/host.mjs",
    "screenshots": "node screenshots/build.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-files"
      ],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
